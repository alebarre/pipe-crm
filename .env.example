# ---------------------------------------------------------------------------
# Banco
# ---------------------------------------------------------------------------
# Opcao A (padrao de verdade) — Postgres em container:
#   pnpm db:up && pnpm db:migrate && pnpm db:seed
# DATABASE_URL=postgres://pipe:pipe@localhost:5432/pipe_crm
#
# Opcao B — Postgres embarcado (WASM), sem Docker nenhum. Mesmo dialeto e
# mesmas migrations; roda um processo por vez sobre o diretorio de dados.
DATABASE_URL=pglite://.pgdata

# ---------------------------------------------------------------------------
# API
# ---------------------------------------------------------------------------
API_PORT=3333
API_HOST=0.0.0.0

# Origem do front liberada no CORS. Em dev o Vite faz proxy de /api,
# entao o navegador nunca faz requisicao cross-origin.
WEB_ORIGIN=http://localhost:5173

# ---------------------------------------------------------------------------
# Autenticacao
# ---------------------------------------------------------------------------
# Gere os seus com:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Fora de producao ha default embutido; em producao a API se recusa a subir sem.
JWT_SECRET=
COOKIE_SECRET=

ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7
RESET_TOKEN_TTL_MINUTES=60

# Credenciais do primeiro admin, criadas por `pnpm db:seed`.
# /auth/register cria sempre um usuario comum: admin so nasce aqui.
SEED_ADMIN_EMAIL=admin@pipecrm.local
SEED_ADMIN_PASSWORD=admin12345
SEED_USER_EMAIL=user@pipecrm.local
SEED_USER_PASSWORD=user12345

# ---------------------------------------------------------------------------
# E-mail — SMTP
# ---------------------------------------------------------------------------
# No Gmail, SMTP_PASSWORD e uma "senha de app" (myaccount.google.com/apppasswords),
# nao a senha da conta. Sem SMTP_USER/SMTP_PASSWORD a API nao envia nada: o link
# de recuperacao e impresso no log, o que basta para desenvolver.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Pipe CRM <nao-responda@exemplo.com>
